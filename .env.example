# LingoPDF 环境变量示例（复制为 .env 使用；或直接在网页设置里配置）
# 环境变量优先级高于网页设置，适合 Docker / 服务器部署

# 翻译引擎: openai | google | argos
LINGO_ENGINE=openai

# OpenAI 兼容 API（引擎=openai 时必填）
LINGO_BASE_URL=https://api.deepseek.com
LINGO_API_KEY=sk-your-key-here
LINGO_MODEL=deepseek-chat

# 语言方向
LINGO_LANG_IN=en
LINGO_LANG_OUT=zh
